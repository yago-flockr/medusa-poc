# Local Postgres (see root docker-compose.yml)
DATABASE_URL=postgres://medusa:medusa@localhost:5432/medusa_poc

# Local Redis (see root docker-compose.yml). If unset, Medusa uses in-memory fake Redis.
REDIS_URL=redis://localhost:6379

STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:9000,http://localhost:8000

# /vendors/* is a custom route tree, not covered by Medusa's built-in
# STORE_CORS/ADMIN_CORS/AUTH_CORS (those only apply to /store, /admin, /auth).
# The vendor UI (apps/storefront's /vendor segment) is built SPA-style —
# plain browser fetch, not a Server Action — so it needs this set to the
# storefront's own origin.
VENDOR_CORS=http://localhost:8000

# Dev-only placeholders. Replace before any shared/staging deploy.
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
