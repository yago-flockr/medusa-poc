# Local Postgres (see root docker-compose.yml)
DATABASE_URL=postgres://medusa:medusa@localhost:5432/medusa_poc

# Local Redis (see root docker-compose.yml). If unset, Medusa uses in-memory fake Redis.
REDIS_URL=redis://localhost:6379

STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:9000,http://localhost:8000
# VENDOR_CORS=http://localhost:8000
# On Medusa Cloud: STORE_CORS/ADMIN_CORS/AUTH_CORS are auto-configured for
# the storefront app in the same project, but VENDOR_CORS is a custom var
# this project defines — Cloud has no knowledge of it and never sets it.
# Set VENDOR_CORS explicitly in the Cloud dashboard to the vendor panel's
# real origin(s) (comma-separated for more than one), or /vendors/* CORS
# falls back to STORE_CORS (src/api/vendors/cors.ts) and only works if that
# happens to already cover the right origin. Supports the same
# `/regex/flags`-shaped entry Medusa's own CORS vars do (for matching a
# dynamic preview domain), parsed via parseCorsOrigins — see cors.ts.

# Dev-only placeholders. Replace before any shared/staging deploy.
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
