meta {
  name: regenerate-password
  type: http
  seq: 5
}

post {
  url: {{base_url}}/admin/vendor-users/:id/regenerate-password
  body: none
  auth: inherit
}

params:path {
  id: {{admin_vendor_user_id}}
}

docs {
  Security, not UX: there is no self-service password reset yet, so staff
  regenerates a fresh random password here (`res.body.password`) and shares
  it with the vendor themselves. The previous password stops working
  immediately.
}
