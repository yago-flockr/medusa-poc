meta {
  name: login-vendor-b
  type: http
  seq: 3
}

post {
  url: {{base_url}}/auth/vendor/emailpass
  body: json
  auth: none
}

body:json {
  {
    "email": "{{vendor_b_email}}",
    "password": "{{vendor_b_password}}"
  }
}

script:post-response {
  bru.setVar("vendor_b_token", res.body.token);
}
