meta {
  name: register-vendor-b
  type: http
  seq: 1
}

post {
  url: {{base_url}}/auth/vendor/emailpass/register
  body: json
  auth: none
}

script:pre-request {
  bru.setVar("vendor_b_email", `vendor-b+${Date.now()}@example.com`);
}

body:json {
  {
    "email": "{{vendor_b_email}}",
    "password": "{{vendor_b_password}}"
  }
}

script:post-response {
  bru.setVar("vendor_b_reg_token", res.body.token);
}
