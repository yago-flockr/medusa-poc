meta {
  name: create-vendor-b
  type: http
  seq: 2
}

post {
  url: {{base_url}}/vendors
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{vendor_b_reg_token}}
}

body:json {
  {
    "name": "Bolt",
    "handle": "bolt",
    "user": {
      "email": "{{vendor_b_email}}",
      "first_name": "Bob"
    }
  }
}

script:post-response {
  bru.setVar("vendor_b_id", res.body.vendor.id);
}
