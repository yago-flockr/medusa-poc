meta {
  name: create-vendor-user
  type: http
  seq: 2
}

post {
  url: {{base_url}}/admin/vendor-users
  body: json
  auth: none
}

script:pre-request {
  let token = bru.getVar("admin_token");

  if (!token) {
    const res = await bru.sendRequest({
      method: "POST",
      url: bru.getEnvVar("base_url") + "/auth/user/emailpass",
      headers: {
        "Content-Type": "application/json"
      },
      data: {
        email: bru.getEnvVar("admin_email"),
        password: bru.getEnvVar("admin_password")
      }
    });

    token = res && res.data && res.data.token;
    if (token) {
      bru.setVar("admin_token", token);
    }
  }

  if (!token) {
    throw new Error("Could not obtain admin JWT");
  }

  req.setHeader("Authorization", "Bearer " + token);
  bru.setVar("vendor_email", `vendor+${Date.now()}@example.com`);
}

body:json {
  {
    "vendor_id": "{{vendor_id}}",
    "email": "{{vendor_email}}",
    "first_name": "Alice"
  }
}

script:post-response {
  bru.setVar("vendor_password", res.body.password);
}

docs {
  Staff creates the vendor's first user from the Admin panel. The password
  is generated server-side and returned once here — `login` (next) uses it.
}
